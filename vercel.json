{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/2025Recap/:path*",
      "destination": "/2025/:path*",
      "permanent": true
    },
    {
      "source": "/2024Recap/:path*",
      "destination": "/2024/:path*",
      "permanent": true
    },
    {
      "source": "/2023Recap/:path*",
      "destination": "/2023/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
